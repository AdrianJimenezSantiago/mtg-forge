# `engine-strict` hace que npm FALLE si la versión de Node no cumple el campo
# `engines` de package.json, en lugar de limitarse a avisar.
#
# Sin esto, `npm ci` instalaba jsdom 30 y undici 8 bajo Node 20 sin protestar y
# el fallo aparecía mucho después, en tiempo de ejecución, como un
# "webidl.util.markAsUncloneable is not a function" imposible de relacionar con
# la causa.
engine-strict=true
